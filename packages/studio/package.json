{
  "name": "@tavernpi/studio",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "tavern studio：tavernpi 内核的 GUI 外壳（Electron 同进程嵌入内核，不走 RPC）。S1：React + Vite 渲染层 + turn_log 阅读流。",
  "main": "src/main/index.ts",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "spike": "env -u ELECTRON_RUN_AS_NODE electron spike/s0-smoke.cjs",
    "accept:s0": "env -u ELECTRON_RUN_AS_NODE electron . --s0-accept",
    "accept:s1": "env -u ELECTRON_RUN_AS_NODE electron . --s1-accept",
    "build:renderer": "vite build",
    "dev:renderer": "vite"
  },
  "dependencies": {
    "@tavernpi/core": "0.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
